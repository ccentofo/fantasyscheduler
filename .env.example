# ──────────────────────────────────────────────────────────────────────
# Fantasy Football Scheduler UI — environment variables
#
# Copy this file to ".env" and edit as needed:
#   cp .env.example .env
#
# REACT_APP_DEFAULT_API_BASE is REQUIRED. The dev server runs on port 3000.
# ──────────────────────────────────────────────────────────────────────

# Default base URL the UI points at on first load.
# Users can still override this at runtime from the in-app Settings dialog
# (persisted to localStorage).
# Examples:
#   REACT_APP_DEFAULT_API_BASE=http://127.0.0.1:8080
#   REACT_APP_DEFAULT_API_BASE=https://scheduler.my-league.net
REACT_APP_DEFAULT_API_BASE=https://api.fantasyschedulemaker.com

# Dev server port (default: 3000). Uncomment to change.
# PORT=3000

# Prevent Create React App from auto-opening a browser tab on `yarn start`.
# BROWSER=none
